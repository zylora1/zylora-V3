APP_ENV=development
APP_URL=http://127.0.0.1:8000
# REQUIRED for production: set APP_ENV=production and APP_URL=https://your-real-zylora-domain
DATABASE_URL=sqlite:///./data/zylora.db
SESSION_TTL_HOURS=168
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Optional one-time SUPER_ADMIN bootstrap. Set both for the first production boot.
# The plaintext password is never written to the database and is never re-synced on later boots.
# After successful bootstrap, remove SUPER_ADMIN_PASSWORD from the deployment environment.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
SALES_ASSISTANT_MODEL=gpt-4o-mini

# Transactional email — Resend HTTPS API (SMTP is not used by Zylora production)
RESEND_API_KEY=
RESEND_FROM="Zylora <notifications@zylora.example>"

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Preferred production WhatsApp provider (Meta remains an optional fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

WHATSAPP_GRAPH_VERSION=v23.0

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_SAAS_TARGET=sites.zylora.example
PUBLIC_BASE_DOMAIN=zylora.example
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# Google Sheets server-to-server integration. Share the target spreadsheet with this service account.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Cloudflare Turnstile bot protection for public forms/chat/appointments
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Editor media storage. Use S3 for horizontally-scaled production, or mount MEDIA_STORAGE_DIR on durable persistent storage.
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_DIR=./data/media
# Set true only when MEDIA_STORAGE_DIR is backed by a persistent volume.
MEDIA_STORAGE_DURABLE=false
MEDIA_MAX_UPLOAD_MB=12
MEDIA_MAX_PIXELS=40000000
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_PREFIX=zylora-media
# Optional licensed stock-image search. Without this key, upload + Media Library remain fully functional.
PEXELS_API_KEY=
