# Canonical environment variable. ENV is also accepted as a compatibility alias.
ZYLORA_ENV=development
ZYLORA_SECRET_KEY=replace-with-at-least-32-random-bytes
DATABASE_URL=postgresql+psycopg://zylora:zylora@localhost:5432/zylora
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=zylora
S3_SECRET_KEY=replace-me
S3_BUCKET=zylora-publications
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
PUBLIC_SITE_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DEFAULT_TIMEZONE=Asia/Kolkata
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Zylora <hello@your-domain.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+10000000000
# Production uses Celery/Redis. Use inline only for local development and tests.
NOTIFICATION_DELIVERY_MODE=celery
NOTIFICATION_MAX_ATTEMPTS=3
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
TURNSTILE_SECRET_KEY=

# Claude-backed website chatbot
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
CHATBOT_KNOWLEDGE_MAX_CHARS=24000
CHATBOT_MAX_MESSAGES_PER_SESSION=40
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CORS_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=0
NEXT_PUBLIC_SITE_URL=http://localhost:3000

RAZORPAY_PLAN_STARTER_ID=
RAZORPAY_PLAN_GROWTH_ID=
