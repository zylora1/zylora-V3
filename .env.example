# Core application / Render runtime
APP_ENV=development
APP_URL=http://127.0.0.1:8000
PORT=8000
# Separate React SUPER_ADMIN portal origin. Leave empty only when no admin portal is deployed.
SUPER_ADMIN_APP_URL=http://127.0.0.1:5174
# REQUIRED for production: set APP_ENV=production and APP_URL=https://your-real-zylora-domain
DATABASE_URL=sqlite:///./data/zylora.db
SESSION_TTL_HOURS=168
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Optional one-time SUPER_ADMIN bootstrap. Set both for the first production boot.
# The plaintext password is never written to the database and is never re-synced on later boots.
# After successful bootstrap, remove SUPER_ADMIN_PASSWORD from the deployment environment.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Hosted AI uses one gateway credential. Model IDs are gateway model IDs.
AI_GATEWAY_PROVIDER=vercel
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_DEFAULT_MODEL=openai/gpt-5-mini
AI_SALES_ASSISTANT_MODEL=openai/gpt-4o-mini
AI_EDITOR_MODEL=openai/gpt-5-mini

# Compatibility-only local/test input. It is never required for production
# hosted inference; production uses AI_GATEWAY_API_KEY through AIService.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
SALES_ASSISTANT_MODEL=gpt-4o-mini
RESEND_API_KEY=
EMAIL_FROM=Zylora <notifications@zylora.dev>
EMAIL_REPLY_TO=
EMAIL_SEND_TIMEOUT=20
EMAIL_BATCH_SIZE=25
EMAIL_MAX_SENDS_PER_MINUTE=60
EMAIL_MAX_RETRIES=4
EMAIL_RETRY_BASE_DELAY=60
EMAIL_CAMPAIGN_UPLOAD_MAX_MB=8
EMAIL_ATTACHMENT_MAX_MB=10
EMAIL_ATTACHMENT_TOTAL_MAX_MB=20
# Required in production; use a random secret of at least 32 characters.
EMAIL_UNSUBSCRIBE_SECRET=

# One communications provider for email, WhatsApp and SMS.
TELNYX_API_KEY=
TELNYX_BASE_URL=https://api.telnyx.com/v2
TELNYX_EMAIL_FROM=
TELNYX_EMAIL_DOMAIN_ID=
TELNYX_WHATSAPP_FROM=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_SMS_FROM=
# Optional Super Admin alert thresholds. Zero disables each alert.
AI_COST_ALERT_USD=0
TELNYX_MESSAGE_ALERT_COUNT=0
COMMUNICATION_FAILURE_ALERT_PCT=0
TELNYX_WEBHOOK_PUBLIC_KEY=
TELNYX_PUBLIC_KEY=

# Compatibility-only WhatsApp/Twilio inputs during the staged cutover.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

WHATSAPP_GRAPH_VERSION=v23.0

GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_SAAS_TARGET=sites.zylora.example
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
PUBLIC_BASE_DOMAIN=zylora.example
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# Google Sheets server-to-server integration. Share the target spreadsheet with this service account.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Optional Cloudflare Turnstile bot protection for public forms/chat/appointments
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Editor media storage. Use S3 for horizontally-scaled production, or mount MEDIA_STORAGE_DIR on durable persistent storage.
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_DIR=./data/media
# Set true only when MEDIA_STORAGE_DIR is backed by a persistent volume.
MEDIA_STORAGE_DURABLE=false
MEDIA_MAX_UPLOAD_MB=12
MEDIA_MAX_PIXELS=40000000
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_PREFIX=zylora-media
# When using Cloudflare R2, set MEDIA_STORAGE_PROVIDER=s3 and use the R2_*
# variables above.  The server maps those names into the existing S3-compatible
# media service; MEDIA_S3_* are retained only for compatibility deployments.
# Optional licensed stock-image search. Without this key, upload + Media Library remain fully functional.
PEXELS_API_KEY=

# Transitional Penpot gate. Leave STUDIO_ENGINE=legacy until a verified upstream
# distribution, commit and SSO bridge have been installed.
STUDIO_ENGINE=legacy
PENPOT_BASE_URL=
PENPOT_INTERNAL_URL=
PENPOT_UPSTREAM_REPO=https://github.com/penpot/penpot
PENPOT_UPSTREAM_VERSION=
PENPOT_UPSTREAM_COMMIT=
OIDC_ISSUER=
OIDC_SIGNING_KEY=
OIDC_SIGNING_KEY_ID=
OIDC_AUDIENCE=
