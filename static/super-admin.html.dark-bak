<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width,initial-scale=1" name="viewport"/>
  <title>Zylora · SUPER_ADMIN Control Plane</title>
  <meta content="noindex,nofollow" name="robots"/>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="/static/zylora-ui.css" rel="stylesheet"/>
  <link href="/static/dashboard.css" rel="stylesheet"/>
  <link href="/static/dashboard-sneat.css" rel="stylesheet"/>
  <style>
    :root {
      --zy-bg-app: #070A0F;
      --zy-bg-sidebar: #0B1018;
      --zy-bg-surface: #0D121B;
      --zy-bg-card: #111823;
      --zy-bg-card-inner: #151D29;
      --zy-accent: #D4FF32;
      --zy-accent-hover: #E2FF66;
      --zy-text-primary: #F1F5F9;
      --zy-text-secondary: #94A3B8;
      --zy-border: rgba(255, 255, 255, 0.08);
      --zy-border-subtle: rgba(255, 255, 255, 0.04);
      --zy-border-active: rgba(212, 255, 50, 0.4);
      --zy-success: #36D399;
      --zy-warning: #F6C453;
      --zy-error: #FF5D68;
    }

    body {
      background: var(--zy-bg-app);
      color: var(--zy-text-primary);
      margin: 0;
      font-family: 'Public Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .super-shell {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 260px 1fr;
      background: var(--zy-bg-app);
      color: var(--zy-text-primary);
      width: 100%;
      max-width: 100vw;
      box-sizing: border-box;
    }

    .workspace {
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
      padding: 0 24px 32px;
    }

    .admin-stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }

    .admin-two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 24px;
    }

    .admin-three-col {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      margin-bottom: 24px;
    }

    #adminIntegrationGrid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)) !important;
      gap: 16px;
    }

    .admin-stats article {
      background: var(--zy-bg-card);
      border: 1px solid var(--zy-border);
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
      transition: transform 0.15s ease, border-color 0.15s ease;
      min-width: 0;
    }
    .admin-stats article:hover {
      border-color: rgba(255, 255, 255, 0.16);
      transform: translateY(-1px);
    }

    .admin-stats small {
      display: block;
      color: var(--zy-text-secondary);
      font-size: 12px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .admin-stats b {
      display: block;
      font-size: 28px;
      font-weight: 700;
      color: var(--zy-text-primary);
      margin-top: 8px;
      font-family: 'Space Grotesk', -apple-system, sans-serif;
    }

    .stat-trend {
      word-break: break-word;
      font-size: 11px;
    }

    .admin-pane {
      display: none;
      min-width: 0;
      max-width: 100%;
    }
    .admin-pane.active {
      display: block;
      animation: fadeIn 0.2s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .table-wrap {
      background: var(--zy-bg-card);
      border: 1px solid var(--zy-border);
      border-radius: 12px;
      overflow-x: auto !important;
      max-width: 100%;
      -webkit-overflow-scrolling: touch;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    @media (max-width: 1199.98px) {
      .super-shell {
        grid-template-columns: 1fr !important;
        display: block !important;
      }
      .rail.sneat-sidebar {
        position: fixed !important;
        left: -260px !important;
        z-index: 1050;
        transition: left 0.25s ease !important;
      }
      .super-shell.sidebar-open .rail.sneat-sidebar,
      .app-shell.sidebar-open .rail.sneat-sidebar {
        left: 0 !important;
      }
      .sidebar-toggle {
        display: block !important;
      }
      .workspace {
        padding: 0 16px 24px !important;
      }
      .admin-stats {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      }
      .admin-three-col {
        grid-template-columns: 1fr !important;
      }
    }

    @media (max-width: 900px) {
      .admin-two-col {
        grid-template-columns: 1fr !important;
      }
      .split-admin {
        grid-template-columns: 1fr !important;
      }
    }

    @media (max-width: 640px) {
      .admin-stats {
        grid-template-columns: 1fr !important;
      }
    }

    .admin-brand-tag {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      background: rgba(212, 255, 50, 0.15);
      color: var(--zy-accent);
      border: 1px solid rgba(212, 255, 50, 0.3);
      padding: 2px 7px;
      border-radius: 4px;
      margin-left: 8px;
    }

    .admin-filter-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }

    .admin-filter-row input, .admin-filter-row select {
      border: 1px solid var(--zy-border);
      background: var(--zy-bg-card-inner);
      border-radius: 8px;
      padding: 9px 14px;
      font-size: 13px;
      color: var(--zy-text-primary);
      outline: none;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .admin-filter-row input:focus, .admin-filter-row select:focus {
      border-color: var(--zy-border-active);
      box-shadow: 0 0 0 2px rgba(212, 255, 50, 0.15);
    }

    .admin-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 24px;
    }

    #adminIntegrationGrid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 16px;
    }

    .admin-stats article {
      background: var(--zy-bg-card);
      border: 1px solid var(--zy-border);
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
      transition: transform 0.15s ease, border-color 0.15s ease;
    }
    .admin-stats article:hover {
      border-color: rgba(255, 255, 255, 0.16);
      transform: translateY(-1px);
    }

    .admin-stats small {
      display: block;
      color: var(--zy-text-secondary);
      font-size: 12px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .admin-stats b {
      display: block;
      font-size: 28px;
      font-weight: 700;
      color: var(--zy-text-primary);
      margin-top: 8px;
      font-family: 'Space Grotesk', -apple-system, sans-serif;
    }

    .admin-pane {
      display: none;
    }
    .admin-pane.active {
      display: block;
      animation: fadeIn 0.2s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .table-wrap {
      background: var(--zy-bg-card);
      border: 1px solid var(--zy-border);
      border-radius: 12px;
      overflow: hidden;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    th {
      background: var(--zy-bg-card-inner);
      color: var(--zy-text-secondary);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 12px 16px;
      text-align: left;
      border-bottom: 1px solid var(--zy-border);
    }

    td {
      padding: 14px 16px;
      border-bottom: 1px solid var(--zy-border-subtle);
      color: var(--zy-text-primary);
    }

    tr:last-child td {
      border-bottom: none;
    }

    tr:hover td {
      background: rgba(255, 255, 255, 0.02);
    }

    .panel {
      background: var(--zy-bg-card);
      border: 1px solid var(--zy-border);
      border-radius: 12px;
      padding: 20px;
    }

    .panel-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .panel-title span {
      font-size: 16px;
      font-weight: 600;
      color: var(--zy-text-primary);
    }

    .panel-title small {
      display: block;
      color: var(--zy-text-secondary);
      font-size: 12px;
      margin-top: 2px;
    }

    .settings-card {
      background: var(--zy-bg-card);
      border: 1px solid var(--zy-border);
      border-radius: 12px;
      padding: 24px;
    }

    .settings-card h2 {
      color: var(--zy-text-primary);
      margin-top: 0;
      font-size: 18px;
    }

    .settings-card input, .settings-card select, .settings-card textarea {
      background: var(--zy-bg-card-inner);
      border: 1px solid var(--zy-border);
      color: var(--zy-text-primary);
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 13px;
    }

    .settings-card input:focus, .settings-card select:focus, .settings-card textarea:focus {
      border-color: var(--zy-border-active);
      box-shadow: 0 0 0 2px rgba(212, 255, 50, 0.15);
      outline: none;
    }
  </style>
</head>
<body>
<div class="app-shell super-shell">
  <aside aria-label="Zylora Super Admin navigation" class="rail sneat-sidebar">
    <a aria-label="Zylora Super Admin Home" class="rail-logo z-wordmark" href="/super-admin">
      <span class="zylora-logo-mark">Z</span>
      <span class="zylora-logo-type">Zylora</span>
      <span class="admin-brand-tag">Admin</span>
    </a>
    <nav aria-label="Control plane sections">
      <p class="menu-section">Control Plane</p>
      <button class="rail-btn active" data-admin-tab="adminOverview" type="button">
        <span class="menu-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5"></path><path d="M5.5 9.5V21h13V9.5"></path><path d="M9.5 21v-6h5v6"></path></svg></span>
        <span class="menu-label">Overview</span>
      </button>
      <button class="rail-btn" data-admin-tab="adminUsers" type="button">
        <span class="menu-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></span>
        <span class="menu-label">Users</span>
      </button>
      <button class="rail-btn" data-admin-tab="adminTemplates" type="button">
        <span class="menu-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><rect height="8" rx="1.5" width="8" x="3" y="3"></rect><rect height="8" rx="1.5" width="8" x="13" y="3"></rect><rect height="8" rx="1.5" width="8" x="3" y="13"></rect><rect height="8" rx="1.5" width="8" x="13" y="13"></rect></svg></span>
        <span class="menu-label">Templates &amp; Import</span>
      </button>
      <button class="rail-btn" data-admin-tab="adminPlatformBlog" type="button">
        <span class="menu-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path><path d="M6 6h10M6 10h10M6 14h6"></path></svg></span>
        <span class="menu-label">Platform Blog</span>
      </button>
      <button class="rail-btn" data-admin-tab="adminPlans" type="button">
        <span class="menu-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><rect height="14" rx="2" width="18" x="3" y="5"></rect><path d="M3 10h18M7 15h4"></path></svg></span>
        <span class="menu-label">Plans &amp; Pricing</span>
      </button>
      <button class="rail-btn" data-admin-tab="adminCampaigns" type="button">
        <span class="menu-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg></span>
        <span class="menu-label">Campaigns</span>
      </button>
      
      <p class="menu-section">Operations &amp; CRM</p>
      <button class="rail-btn" data-admin-tab="adminLeads" type="button">
        <span class="menu-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"></circle><path d="M3.5 20v-1.5A4.5 4.5 0 0 1 8 14h2a4.5 4.5 0 0 1 4.5 4.5V20"></path></svg></span>
        <span class="menu-label">Global Leads</span>
      </button>
      <button class="rail-btn" data-admin-tab="adminFreelancers" type="button">
        <span class="menu-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><rect height="13" rx="2" width="18" x="3" y="7"></rect><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 12h18M9 12v2h6v-2"></path></svg></span>
        <span class="menu-label">Freelancers</span>
      </button>
      <button class="rail-btn" data-admin-tab="adminSupport" type="button">
        <span class="menu-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 5h16v12H9l-5 4z"></path></svg></span>
        <span class="menu-label">Support</span>
      </button>
      <button class="rail-btn" data-admin-tab="adminPro" type="button">
        <span class="menu-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg></span>
        <span class="menu-label">Managed CRM</span>
      </button>

      <p class="menu-section">Revenue &amp; Analytics</p>
      <button class="rail-btn" data-admin-tab="adminPayments" type="button">
        <span class="menu-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><rect height="14" rx="2" width="20" x="2" y="5"></rect><line x1="2" x2="22" y1="10" y2="10"></line></svg></span>
        <span class="menu-label">Payments &amp; Revenue</span>
      </button>

      <p class="menu-section">System &amp; Security</p>
      <button class="rail-btn" data-admin-tab="adminIntegrations" type="button">
        <span class="menu-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M16 16v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path><polyline points="15 12 21 12"></polyline><polyline points="18 9 21 12 18 15"></polyline></svg></span>
        <span class="menu-label">Integrations</span>
      </button>
      <button class="rail-btn" data-admin-tab="adminHealth" type="button">
        <span class="menu-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg></span>
        <span class="menu-label">Platform Health</span>
      </button>
      <button class="rail-btn" data-admin-tab="adminAudit" type="button">
        <span class="menu-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg></span>
        <span class="menu-label">Audit Logs</span>
      </button>
      <button class="rail-btn" data-admin-tab="adminSystem" type="button">
        <span class="menu-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1v.1H9.6V21a1.7 1.7 0 0 0-.4-1 1.7 1.7 0 0 0-1-.6 1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 3.8 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1-.4H2v-4h.2a1.7 1.7 0 0 0 1-.4 1.7 1.7 0 0 0 .6-1 1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 8.2 3.8a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1V2h4v.2a1.7 1.7 0 0 0 .4 1 1.7 1.7 0 0 0 1 .6 1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.4 8.2c.15.38.36.72.66 1 .3.25.65.4 1.04.4h.1v4h-.1c-.39 0-.74.15-1.04.4-.3.28-.51.62-.66 1Z"></path></svg></span>
        <span class="menu-label">System Settings</span>
      </button>
    </nav>
    <div class="sidebar-user">
      <span class="sidebar-avatar" id="sideAvatar">A</span>
      <span class="sidebar-user-copy">
        <b id="sideUserName">Super Admin</b>
        <small id="sideUserRole" style="color: var(--zy-accent); font-weight: 700;">SUPER_ADMIN</small>
      </span>
    </div>
    <div class="sidebar-foot">
      <a class="rail-btn" href="/dashboard?stay=1" title="Customer Dashboard View" style="color: var(--zy-text-secondary);">
        <span class="menu-icon">↗</span>
        <span class="menu-label">Customer View</span>
      </a>
      <button class="rail-btn logout" id="logoutBtn" title="Log out" type="button">
        <span class="menu-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M10 5H5v14h5M14 8l4 4-4 4M8 12h10"></path></svg></span>
        <span class="menu-label">Log out</span>
      </button>
    </div>
  </aside>

  <main class="workspace">
    <header class="topbar sneat-navbar">
      <button aria-label="Toggle navigation" class="sidebar-toggle" id="sidebarToggle" type="button"><span></span><span></span><span></span></button>
      <div class="search"><span aria-hidden="true">⌕</span><input aria-label="Search" id="adminGlobalSearch" placeholder="Search users, templates, blogs or settings…"/></div>
      <div class="topbar-actions">
        <button class="ghost-btn" id="refreshAdmin" type="button">↻ Refresh Data</button>
        <div class="profile">
          <span class="avatar" style="background:var(--zy-bg-card-inner);color:var(--zy-accent);border:1px solid var(--zy-border);">SA</span>
          <div><b>Super Admin</b><small>PLATFORM OPERATOR</small></div>
        </div>
      </div>
    </header>

    <div class="view-head">
      <div>
        <p class="eyebrow">Zylora Platform Control</p>
        <h1 id="paneTitle">SUPER_ADMIN Control Plane</h1>
        <p id="paneSubtitle">Manage users, templates, platform blog, pricing models, global leads, and system configurations.</p>
      </div>
    </div>

    <!-- 1. Overview -->
    <div class="admin-pane active" id="adminOverview">
      <div class="admin-stats" id="adminStats">
        <article><small>Total Platform Users</small><b id="statTotalUsers">—</b><span class="stat-trend" id="statUserGrowth">Real registered users</span></article>
        <article><small>Active Websites</small><b id="statActiveSites">—</b><span class="stat-trend" id="statSitesSub">Platform created</span></article>
        <article><small>Production Templates</small><b id="statTotalTemplates">—</b><span class="stat-trend">Verified catalogue</span></article>
        <article><small>Total Enquiries</small><b id="statTotalLeads">—</b><span class="stat-trend">Platform pipeline</span></article>
        <article><small>30D Platform Revenue</small><b id="statRevenue">—</b><span class="stat-trend" id="statRevenueSub">INR &amp; USD reconciled</span></article>
        <article><small>Active Users (30D)</small><b id="statActiveUsers">—</b><span class="stat-trend">Unique active sessions</span></article>
        <article><small>AI Generations (24h)</small><b id="statAiUsage">—</b><span class="stat-trend" id="statAiTokens">Tokens consumed</span></article>
        <article><small>Platform Health</small><b id="statPlatformHealth" style="color:var(--zy-success,#36D399);">OPERATIONAL</b><span class="stat-trend" id="statDbLatency">DB Latency: —</span></article>
      </div>

      <!-- Growth & Funnel Row -->
      <div class="admin-two-col">
        <div class="panel">
          <div class="panel-title">
            <div><span>Real User Growth</span><small>New user registrations (7D &amp; 30D)</small></div>
            <span class="status-badge pass" id="overviewGrowthBadge">+0%</span>
          </div>
          <div style="display:flex;gap:24px;margin-top:14px;align-items:center;">
            <div style="flex:1;">
              <div style="display:flex;justify-content:space-between;margin-bottom:6px;font-size:12px;">
                <span style="color:var(--zy-text-secondary);">Last 7 Days</span>
                <b id="growth7dVal">0</b>
              </div>
              <div style="height:8px;background:var(--zy-bg-card-inner);border-radius:4px;overflow:hidden;">
                <div id="growth7dBar" style="height:100%;background:var(--zy-accent);width:0%;transition:width 0.3s;"></div>
              </div>
            </div>
            <div style="flex:1;">
              <div style="display:flex;justify-content:space-between;margin-bottom:6px;font-size:12px;">
                <span style="color:var(--zy-text-secondary);">Last 30 Days</span>
                <b id="growth30dVal">0</b>
              </div>
              <div style="height:8px;background:var(--zy-bg-card-inner);border-radius:4px;overflow:hidden;">
                <div id="growth30dBar" style="height:100%;background:var(--zy-success);width:0%;transition:width 0.3s;"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="panel">
          <div class="panel-title">
            <div><span>Conversion Funnel</span><small>Visitor to paying customer progression</small></div>
            <span class="status-badge info" id="overviewFunnelRate">0% conversion</span>
          </div>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:14px;text-align:center;">
            <div style="background:var(--zy-bg-card-inner);padding:10px;border-radius:8px;border:1px solid var(--zy-border);">
              <small style="color:var(--zy-text-secondary);font-size:11px;">Visitors</small>
              <b id="funnelVisitors" style="display:block;font-size:18px;margin-top:4px;">0</b>
            </div>
            <div style="background:var(--zy-bg-card-inner);padding:10px;border-radius:8px;border:1px solid var(--zy-border);">
              <small style="color:var(--zy-text-secondary);font-size:11px;">Enquiries</small>
              <b id="funnelLeads" style="display:block;font-size:18px;margin-top:4px;">0</b>
            </div>
            <div style="background:var(--zy-bg-card-inner);padding:10px;border-radius:8px;border:1px solid var(--zy-border);">
              <small style="color:var(--zy-text-secondary);font-size:11px;">Paid Users</small>
              <b id="funnelPaid" style="display:block;font-size:18px;margin-top:4px;color:var(--zy-accent);">0</b>
            </div>
          </div>
        </div>
      </div>

      <!-- Operations & Activity Row -->
      <div class="admin-three-col">
        <div class="panel">
          <div class="panel-title"><div><span>AI Infrastructure</span><small>Token distribution</small></div></div>
          <div style="display:flex;flex-direction:column;gap:10px;margin-top:12px;">
            <div style="display:flex;justify-content:space-between;font-size:12.5px;">
              <span style="color:var(--zy-text-secondary);">AI Creator</span>
              <b id="aiCreatorTokens">0 calls</b>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:12.5px;">
              <span style="color:var(--zy-text-secondary);">AI Sales Assistant</span>
              <b id="aiAssistantTokens">0 calls</b>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:12.5px;">
              <span style="color:var(--zy-text-secondary);">Total Generations</span>
              <b id="aiTotalGenerations" style="color:var(--zy-accent);">0</b>
            </div>
          </div>
        </div>

        <div class="panel">
          <div class="panel-title"><div><span>Messaging &amp; Delivery</span><small>Notification channels</small></div></div>
          <div style="display:flex;flex-direction:column;gap:10px;margin-top:12px;">
            <div style="display:flex;justify-content:space-between;font-size:12.5px;">
              <span style="color:var(--zy-text-secondary);">Delivered (Sent)</span>
              <b id="msgSentCount" style="color:var(--zy-success);">0</b>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:12.5px;">
              <span style="color:var(--zy-text-secondary);">Failed / Dead-letter</span>
              <b id="msgFailedCount" style="color:var(--zy-error);">0</b>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:12.5px;">
              <span style="color:var(--zy-text-secondary);">Success Rate</span>
              <b id="msgSuccessRate">100%</b>
            </div>
          </div>
        </div>

        <div class="panel">
          <div class="panel-title"><div><span>Quick Admin Actions</span><small>Common operations</small></div></div>
          <div style="display:flex;flex-direction:column;gap:8px;margin-top:8px;">
            <button class="accent-btn compact-btn" data-action="admin-import-template" type="button">＋ Universal Project Import</button>
            <button class="ghost-btn compact-btn" data-admin-jump="adminCampaigns" type="button">New Broadcast Campaign</button>
            <button class="ghost-btn compact-btn" data-admin-jump="adminPlatformBlog" type="button">Draft Platform Blog</button>
            <button class="ghost-btn compact-btn" data-admin-jump="adminPlans" type="button">Adjust Pricing Plans</button>
          </div>
        </div>
      </div>

      <!-- Live Audit Log Stream -->
      <div class="panel">
        <div class="panel-title">
          <div><span>Live Platform Audit Stream</span><small>Recent operator and security events</small></div>
          <button class="ghost-btn compact-btn" data-admin-jump="adminAudit" type="button">View All Audit Logs</button>
        </div>
        <div class="stack-list" id="overviewAuditStream">
          <p class="muted-copy">Loading audit stream…</p>
        </div>
      </div>
    </div>

    <!-- 2. Users -->
    <div class="admin-pane" id="adminUsers">
      <div class="admin-filter-row">
        <input id="adminUserSearch" placeholder="Search user by name, email, or ID..." style="flex: 1;"/>
        <select id="adminUserRoleFilter" style="width: 140px;">
          <option value="">All roles</option>
          <option value="USER">User</option>
          <option value="SUPER_ADMIN">Super Admin</option>
        </select>
        <select id="adminUserPlanFilter" style="width: 140px;">
          <option value="">All plans</option>
          <option value="FREE">Free</option>
          <option value="STARTER">Starter</option>
          <option value="GROWTH">Growth</option>
          <option value="PRO">Managed</option>
        </select>
        <select id="adminUserStatusFilter" style="width: 140px;">
          <option value="">All statuses</option>
          <option value="ACTIVE">Active</option>
          <option value="RESTRICTED">Restricted</option>
        </select>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>User</th><th>Role</th><th>Plan</th><th>AI Credits</th><th>Status</th><th>Joined</th><th>Actions</th></tr>
          </thead>
          <tbody id="adminUserRows"></tbody>
        </table>
      </div>
    </div>

    <!-- 3. Templates & Universal Import -->
    <div class="admin-pane" id="adminTemplates">
      <div class="card-head" style="margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
        <div>
          <h2>Template catalogue &amp; Universal Import</h2>
          <p class="muted-copy">Manage licensed and imported templates, inspect build readiness, toggle catalog visibility, and import complete projects.</p>
        </div>
        <button class="accent-btn" data-action="admin-import-template">＋ Universal Website / Template Import</button>
      </div>
      <div class="admin-filter-row">
        <input id="adminTemplateSearch" placeholder="Search templates by name, category, or slug..." style="flex: 1;"/>
        <select id="adminTemplateStateFilter" style="width: 160px;">
          <option value="">All statuses</option>
          <option value="public">Public</option>
          <option value="archived">Archived</option>
        </select>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Template</th><th>Category</th><th>Pages</th><th>Status</th><th>Render gate</th><th>Actions</th></tr>
          </thead>
          <tbody id="adminTemplateRows"></tbody>
        </table>
      </div>
    </div>

    <!-- 4. Global Leads -->
    <div class="admin-pane" id="adminLeads">
      <div class="table-wrap lead-table-wrap">
        <table class="lead-table">
          <thead>
            <tr><th class="check-cell"><span class="sr-only">Select</span></th><th>Lead</th><th>Owner</th><th>Source</th><th>Website</th><th>Contact</th><th>Created</th><th><span class="sr-only">Actions</span></th></tr>
          </thead>
          <tbody id="adminLeadRows"></tbody>
        </table>
        <div class="empty mini" id="adminLeadEmpty">No leads across the platform yet.</div>
      </div>
    </div>

    <!-- 5. Plans & Pricing -->
    <div class="admin-pane" id="adminPlans">
      <div class="plan-admin-grid" id="adminPlanGrid"></div>
    </div>

    <!-- 6. Freelancers -->
    <div class="admin-pane" id="adminFreelancers">
      <div class="admin-filter-row">
        <input id="adminFreelancerSearch" placeholder="Search name or email"/>
        <select id="adminFreelancerStatus">
          <option value="">All statuses</option>
          <option>PENDING</option>
          <option>APPROVED</option>
          <option>REJECTED</option>
          <option>SUSPENDED</option>
        </select>
        <button class="ghost-btn" id="adminFreelancerFilter">Apply filters</button>
      </div>
      <div class="support-layout">
        <div class="settings-card"><div class="stack-list" id="adminFreelancerList"></div></div>
        <form class="settings-card" id="adminFreelancerEditor">
          <h2>Freelancer moderation</h2>
          <p class="muted-copy">Inspect, edit public profile data, approve, reject, suspend or reactivate applications.</p>
          <input id="adminFreelancerId" type="hidden"/>
          <label>Status<select id="adminFreelancerEditStatus"><option>PENDING</option><option>APPROVED</option><option>REJECTED</option><option>SUSPENDED</option></select></label>
          <label>Display name<input id="adminFreelancerEditName"/></label>
          <label>Full name<input id="adminFreelancerEditFullName"/></label>
          <label>Short bio<textarea id="adminFreelancerEditBio"></textarea></label>
          <label>Description<textarea class="tall" id="adminFreelancerEditDescription"></textarea></label>
          <label>Skills, comma-separated<input id="adminFreelancerEditSkills"/></label>
          <label>Services, comma-separated<input id="adminFreelancerEditServices"/></label>
          <div class="form-grid-2">
            <label>Years experience<input id="adminFreelancerEditYears" min="0" type="number"/></label>
            <label>Starting price<input id="adminFreelancerEditPrice" min="0" step="0.01" type="number"/></label>
            <label>Currency<input id="adminFreelancerEditCurrency" maxlength="3"/></label>
            <label>Location<input id="adminFreelancerEditLocation"/></label>
          </div>
          <label>External URLs, one per line<textarea id="adminFreelancerEditLinks"></textarea></label>
          <label>Moderation/rejection note<textarea id="adminFreelancerEditReason"></textarea></label>
          <button class="accent-btn" type="submit">Save moderation</button>
          <div class="status-msg" id="adminFreelancerMsg"></div>
        </form>
      </div>
    </div>

    <!-- 7. Support Desk -->
    <div class="admin-pane" id="adminSupport">
      <div class="admin-filter-grid">
        <input id="adminSupportSearch" placeholder="Reference, subject, user or email"/>
        <select id="adminSupportStatus">
          <option value="">All statuses</option>
          <option>OPEN</option>
          <option>WAITING_ON_SUPPORT</option>
          <option>WAITING_ON_USER</option>
          <option>RESOLVED</option>
        </select>
        <select id="adminSupportPlan">
          <option value="">All plans</option>
          <option>FREE</option>
          <option>ZYLORA</option>
          <option>STARTER</option>
          <option>GROWTH</option>
          <option>PRO</option>
        </select>
        <select id="adminSupportWebsite"><option value="">All websites</option></select>
        <select id="adminSupportAssignee"><option value="">All assignees</option></select>
        <button class="ghost-btn" id="adminSupportFilter">Apply filters</button>
      </div>
      <div class="support-layout">
        <div class="settings-card"><div class="stack-list" id="adminSupportList"></div></div>
        <div class="settings-card support-thread" id="adminSupportThread">
          <div class="empty mini">Select a support conversation.</div>
        </div>
      </div>
    </div>

    <!-- 8. Managed CRM -->
    <div class="admin-pane" id="adminPro">
      <div class="table-wrap">
        <table>
          <thead><tr><th>Code</th><th>Client</th><th>Project</th><th>Preferred time</th><th>Status</th><th>Amount</th><th>Update</th></tr></thead>
          <tbody id="adminProRows"></tbody>
        </table>
      </div>
    </div>

    <!-- 9. Platform Blog CMS -->
    <div class="admin-pane" id="adminPlatformBlog">
      <div class="split-admin">
        <form class="settings-card" id="platformBlogForm">
          <h2>Publish Zylora article</h2>
          <label>Title<input id="platformBlogTitle" required=""/></label>
          <label>Excerpt<textarea id="platformBlogExcerpt" required=""></textarea></label>
          <label>Article<textarea class="tall" id="platformBlogContent" required=""></textarea></label>
          <button class="accent-btn" type="submit">Create draft</button>
          <div class="status-msg" id="platformBlogMsg"></div>
        </form>
        <div class="settings-card">
          <div class="stack-list" id="platformBlogList"></div>
        </div>
      </div>
    </div>

    <!-- 10. Audit Logs -->
    <div class="admin-pane" id="adminAudit">
      <div class="stack-list" id="auditList"></div>
    </div>

    <!-- 11. System Settings -->
    <div class="admin-pane" id="adminSystem">
      <div class="split-admin">
        <form class="settings-card" id="adminSystemForm">
          <h2>Platform settings</h2>
          <label>Admin notification email<input id="adminNotificationEmail" placeholder="admin@example.com" type="email"/></label>
          <div class="check-row"><input checked="" id="publicSignupEnabled" type="checkbox"/><span>Allow public signup</span></div>
          <label>Source export price · USD cents<input id="sourceExportUsd" min="0" type="number"/></label>
          <label>Source export price · INR paise<input id="sourceExportInr" min="0" type="number"/></label>
          <hr/>
          <h3>Self-service provider plan IDs</h3>
          <p class="muted-copy">Public prices are controlled in the Plans tab. These IDs map Starter and Growth to independent India and international Razorpay subscriptions; no FX conversion is used.</p>
          <div class="form-grid-2">
            <label>Starter · India Razorpay plan ID<input id="starterIndiaPlanId" maxlength="200" placeholder="plan_…"/></label>
            <label>Starter · International Razorpay plan ID<input id="starterInternationalPlanId" maxlength="200" placeholder="plan_…"/></label>
            <label>Growth · India Razorpay plan ID<input id="growthIndiaPlanId" maxlength="200" placeholder="plan_…"/></label>
            <label>Growth · International Razorpay plan ID<input id="growthInternationalPlanId" maxlength="200" placeholder="plan_…"/></label>
          </div>
          <hr/>
          <h3>AI Sales Assistant guardrails</h3>
          <p class="muted-copy">The Assistant is unlimited as a plan entitlement and does not consume AI or lead credits. The controls below are operational abuse and safety guardrails, not a monthly quota.</p>
          <div class="form-grid-2">
            <label>Messages / visitor session<input id="assistantSessionLimit" min="1" type="number" value="40"/></label>
            <label>Site messages / hour<input id="assistantSiteHourlyLimit" min="1" type="number" value="500"/></label>
            <label>Input character limit<input id="assistantInputLimit" min="200" type="number" value="4000"/></label>
            <label>Max output tokens<input id="assistantOutputLimit" min="80" type="number" value="500"/></label>
            <label>Conversation retention days<input id="assistantRetentionDays" min="30" type="number" value="365"/></label>
          </div>
          <button class="accent-btn" data-testid="admin-system-save" type="submit">Save platform settings</button>
          <div class="status-msg" id="adminSystemMsg"></div>
        </form>
        <div class="settings-card">
          <h2>Provider operations</h2>
          <p class="muted-copy">OAuth, Razorpay, Cloudflare, SMTP, WhatsApp, Turnstile, Google Sheets and OpenAI credentials are injected through environment variables. Production providers fail closed when required credentials are missing.</p>
        </div>
      </div>
    </div>

    <!-- Campaigns -->
    <div class="admin-pane" id="adminCampaigns">
      <div class="split-admin">
        <form class="settings-card" id="adminCampaignForm">
          <h2>Create Platform Campaign</h2>
          <p class="muted-copy">Schedule or broadcast platform announcements to registered users.</p>
          <label>Campaign Title<input id="campaignTitle" placeholder="Monthly Product Update" required/></label>
          <div class="form-grid-2">
            <label>Target Audience
              <select id="campaignAudience">
                <option value="ALL">All Registered Users</option>
                <option value="FREE">Free Plan Users</option>
                <option value="STARTER">Starter Plan Users</option>
                <option value="GROWTH">Growth Plan Users</option>
              </select>
            </label>
            <label>Delivery Channel
              <select id="campaignChannel">
                <option value="EMAIL">Email</option>
                <option value="WHATSAPP">WhatsApp</option>
                <option value="NOTIFICATION">Dashboard Notification</option>
              </select>
            </label>
          </div>
          <label>Subject Line<input id="campaignSubject" placeholder="What's new in Zylora" required/></label>
          <label>Message Content<textarea class="tall" id="campaignBody" placeholder="Write message body…" required></textarea></label>
          <div class="form-actions" style="margin-top:14px;display:flex;gap:10px;">
            <button class="accent-btn" type="submit">Create Campaign</button>
          </div>
          <div class="status-msg" id="campaignMsg"></div>
        </form>
        <div class="settings-card">
          <div class="card-head" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
            <h2>Platform Campaigns</h2>
            <button class="ghost-btn compact-btn" id="refreshCampaigns">↻ Refresh</button>
          </div>
          <div class="stack-list" id="campaignList"><p class="muted-copy">No campaigns created yet.</p></div>
        </div>
      </div>
    </div>

    <!-- Payments & Revenue -->
    <div class="admin-pane" id="adminPayments">
      <div class="admin-filter-row">
        <input id="adminPaymentSearch" placeholder="Search by payment ID, order ID, or user..." style="flex:1;"/>
        <select id="adminPaymentKindFilter" style="width:160px;">
          <option value="">All transaction types</option>
          <option value="SUBSCRIPTION">Subscriptions</option>
          <option value="TOPUP">Credit Top-ups</option>
          <option value="EXPORT">Source Export</option>
        </select>
        <select id="adminPaymentStatusFilter" style="width:140px;">
          <option value="">All statuses</option>
          <option value="captured">Captured</option>
          <option value="paid">Paid</option>
          <option value="created">Created</option>
          <option value="failed">Failed</option>
        </select>
        <button class="ghost-btn" id="refreshPayments">↻ Refresh</button>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Order / Payment ID</th><th>User</th><th>Type / Plan</th><th>Amount</th><th>Status</th><th>Date</th></tr>
          </thead>
          <tbody id="adminPaymentRows"></tbody>
        </table>
      </div>
    </div>

    <!-- Integrations -->
    <div class="admin-pane" id="adminIntegrations">
      <div class="card-head" style="margin-bottom:18px;">
        <h2>Ecosystem Integrations Status</h2>
        <p class="muted-copy">Operational verification and connection health for third-party services and provider APIs.</p>
      </div>
      <div id="adminIntegrationGrid">
        <p class="muted-copy">Loading integrations…</p>
      </div>
    </div>

    <!-- Platform Health -->
    <div class="admin-pane" id="adminHealth">
      <div class="admin-stats" style="margin-bottom:20px;">
        <article><small>Database Latency</small><b id="healthDbLatency">—</b><span class="stat-trend" id="healthDbEngine">—</span></article>
        <article><small>Engine Status</small><b id="healthEngineStatus" style="color:var(--zy-success);">HEALTHY</b><span class="stat-trend">Read/Write verified</span></article>
        <article><small>Redis Cache</small><b id="healthRedisStatus">—</b><span class="stat-trend">Rate limiter storage</span></article>
        <article><small>Total Events</small><b id="healthEventCount">—</b><span class="stat-trend">Tracked operations</span></article>
      </div>
      <div class="panel">
        <div class="panel-title">
          <div><span>Operational Event Log</span><small>System alerts, security warnings and platform audit signals</small></div>
          <button class="ghost-btn compact-btn" id="refreshHealth">↻ Refresh</button>
        </div>
        <div class="table-wrap" style="margin-top:14px;">
          <table>
            <thead><tr><th>Time</th><th>Severity</th><th>Event Type</th><th>Component</th><th>Message</th></tr></thead>
            <tbody id="healthEventRows"></tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- Admin Modals: Universal Import, User Detail, Template Edit, Blog Edit -->
<div aria-hidden="true" class="modal" id="importModal">
  <div class="modal-card">
    <button aria-label="Close" class="close" data-close="importModal">×</button>
    <span class="modal-kicker">Universal website &amp; template import</span>
    <h2>Import project into Zylora.</h2>
    <p class="muted-copy">Upload an HTML file or a ZIP containing HTML/CSS/JS, React, Next.js, Angular, Vue/Nuxt, Svelte/SvelteKit or Astro. Zylora safely normalizes the project and never executes uploaded build scripts.</p>
    <form id="importForm" enctype="multipart/form-data">
      <label>Website / Template name <span class="muted-copy">(optional)</span><input maxlength="120" name="site_name" placeholder="My imported project"/></label>
      <label>Project file<input accept=".zip,.html,.htm,application/zip,text/html" name="file" required type="file"/></label>
      <button class="accent-btn wide" type="submit">Import and open editor</button>
      <div aria-live="polite" class="status-msg" id="importMsg"></div>
    </form>
  </div>
</div>

<div aria-hidden="true" class="modal" id="adminUserDetailModal">
  <div class="modal-card" style="max-width: 840px; max-height: 90vh; overflow-y: auto;">
    <button aria-label="Close" class="close" data-close="adminUserDetailModal">×</button>
    <span class="modal-kicker">User 360 Inspector · Platform Control Plane</span>
    <h2 id="adminUserDetailTitle">User details</h2>
    <div id="adminUserDetailBody" style="margin-top: 14px;">Loading…</div>
  </div>
</div>

<div aria-hidden="true" class="modal" id="adminTemplateEditModal">
  <div class="modal-card" style="max-width: 580px;">
    <button aria-label="Close" class="close" data-close="adminTemplateEditModal">×</button>
    <span class="modal-kicker">Template metadata</span>
    <h2>Edit template metadata</h2>
    <form id="adminTemplateEditForm">
      <input type="hidden" id="adminTemplateEditSlug"/>
      <label>Name<input id="adminTemplateEditName" required/></label>
      <label>Category / Industry<input id="adminTemplateEditCategory" required/></label>
      <label>Description<textarea id="adminTemplateEditDesc" required></textarea></label>
      <label>Tags (comma-separated)<input id="adminTemplateEditTags"/></label>
      <div class="form-actions" style="margin-top: 18px; display: flex; gap: 10px; justify-content: flex-end;">
        <button type="button" class="ghost-btn" data-close="adminTemplateEditModal">Cancel</button>
        <button type="submit" class="accent-btn">Save metadata</button>
      </div>
      <div class="status-msg" id="adminTemplateEditMsg"></div>
    </form>
  </div>
</div>

<div aria-hidden="true" class="modal" id="adminBlogEditModal">
  <div class="modal-card" style="max-width: 680px;">
    <button aria-label="Close" class="close" data-close="adminBlogEditModal">×</button>
    <span class="modal-kicker">Blog article management</span>
    <h2 id="adminBlogEditModalTitle">Edit article</h2>
    <form id="adminBlogEditForm">
      <input type="hidden" id="adminBlogEditId"/>
      <label>Title<input id="adminBlogEditTitle" required/></label>
      <label>Slug<input id="adminBlogEditSlug" required/></label>
      <label>Excerpt<textarea id="adminBlogEditExcerpt" required></textarea></label>
      <label>Article content<textarea class="tall" id="adminBlogEditContent" required></textarea></label>
      <div class="form-grid-2">
        <label>SEO title<input id="adminBlogEditSeoTitle"/></label>
        <label>Cover image URL<input id="adminBlogEditCover"/></label>
      </div>
      <div class="form-actions" style="margin-top: 18px; display: flex; gap: 10px; justify-content: space-between;">
        <div style="display: flex; gap: 10px;">
          <button type="submit" class="accent-btn">Save article</button>
          <button type="button" class="ghost-btn" id="adminBlogTogglePublish">Publish</button>
        </div>
        <button type="button" class="danger-btn" id="adminBlogDelete">Delete</button>
      </div>
      <div class="status-msg" id="adminBlogEditMsg"></div>
    </form>
  </div>
</div>

<div class="toast" id="toast" role="status"></div>

<script src="/static/zylora-ui.js"></script>
<script src="/static/super-admin.js"></script>
</body>
</html>
